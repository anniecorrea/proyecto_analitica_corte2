# Entornos virtuales
.venv/
venv/
env/

# Python
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/

# Datos pesados locales
data_mha
data_mha/
C:*/
*.mha
*.zip

# Modelos pesados
*.pth
*.pt
*.ckpt
checkpoints/

# Jupyter checkpoints
.ipynb_checkpoints/

# Editor y sistema
.vscode/
.DS_Store
Thumbs.db

# Caches
.matplotlib_cache/
cache_entrenamiento/
resultados/cache/

# CSV generados localmente
*.csv

# Permitir CSV ligeros de splits y resultados
!splits/*.csv
!resultados/**/*.csv

# Pesos que se comparten con el equipo, via Git LFS (ver .gitattributes)
!resultados/modelos/**/*.pth
!resultados/modelos/**/*.pt
# last_*.pth solo sirven para reanudar un entrenamiento; las corridas smoke son de prueba
resultados/modelos/**/last_*.pth
resultados/modelos/*_smoke/
resultados/metricas/*_smoke/
resultados/figuras/*_smoke/

# Archivos temporales de Word
~$*
